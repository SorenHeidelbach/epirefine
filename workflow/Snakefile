"""Bin refinement with pbinner and Nanomotif, checked with CheckM2.

For each sample: Nanomotif (detect_contamination + include_contigs) and pbinner refine the same bins
from the same motifs and pileup; the original and both refined bin sets are written as FASTA and
scored with CheckM2; an R script compares them. Samples with Hi-C reads (`hic_r1`, `hic_r2`) are
also scored against Hi-C contacts with the scripts in hic/ (rules hic_*).

    snakemake -s workflow/Snakefile --configfile workflow/config.yaml --use-conda --cores 16

Outputs per sample in <outdir>/<sample>/: nanomotif/, pbinner/, bins/<method>/, checkm2/<method>/,
comparison/ (summary.tsv, bins.tsv, figures), and with Hi-C hic/ (contacts, calls) and
hic_validation/ (summary.tsv, contigs.tsv).
"""
from pathlib import Path

REPO = Path(workflow.basedir).parent
HIC = REPO / "hic"
OUT = config.get("outdir", "results")
SAMPLES = config["samples"]
METHODS = ["original", "nanomotif", "pbinner"]
THREADS = config.get("threads", 16)
DB_DIR = config["checkm2_db_dir"]
DB = f"{DB_DIR}/CheckM2_database/uniref100.KO.1.dmnd"


def s(key):
    return lambda wc: SAMPLES[wc.sample][key]


def methods_of(sample):
    """Bin sets compared for a sample: config `methods` (e.g. [original, pbinner] to skip Nanomotif)."""
    return SAMPLES[sample].get("methods", METHODS)


def table_of(sample, method):
    return SAMPLES[sample]["contig_bin"] if method == "original" else f"{OUT}/{sample}/{method}/new_contig_bin.tsv"


def contig_bin_of(wc):
    # "hic" (Hi-C-only refinement, hic/refine.py) writes hic/new_contig_bin.tsv like the methods do
    return table_of(wc.sample, wc.method)


wildcard_constraints:
    sample="[^/]+",
    method="[^/]+",


HIC_SAMPLES = [x for x in SAMPLES if SAMPLES[x].get("hic_r1")]


rule all:
    input:
        expand(f"{OUT}/{{sample}}/comparison/summary.tsv", sample=SAMPLES),
        expand(f"{OUT}/{{sample}}/hic_validation/summary.tsv", sample=HIC_SAMPLES),
        expand(f"{OUT}/{{sample}}/hic_quality/summary.tsv", sample=HIC_SAMPLES),
        expand(f"{OUT}/{{sample}}/hic_probability/probability_vs_hic.pdf", sample=HIC_SAMPLES),


rule nanomotif:
    input:
        assembly=s("assembly"), pileup=s("pileup"), contig_bin=s("contig_bin"), motifs=s("motifs"),
    output:
        new=f"{OUT}/{{sample}}/nanomotif/new_contig_bin.tsv",
        contamination=f"{OUT}/{{sample}}/nanomotif/bin_contamination.tsv",
        include=f"{OUT}/{{sample}}/nanomotif/include_contigs.tsv",
    params:
        extra=config.get("nanomotif_extra", ""),
    log:
        f"{OUT}/{{sample}}/logs/nanomotif.log",
    benchmark:
        f"{OUT}/{{sample}}/benchmarks/nanomotif.tsv"
    threads: THREADS
    conda:
        "envs/nanomotif.yaml"
    shell:
        "nanomotif include_contigs --pileup {input.pileup} --assembly {input.assembly} "
        "--bin_motifs {input.motifs} --contig_bins {input.contig_bin} --run_detect_contamination "
        "-t {threads} --out $(dirname {output.new}) {params.extra} > {log} 2>&1"


rule pbinner:
    input:
        assembly=s("assembly"), pileup=s("pileup"), contig_bin=s("contig_bin"), motifs=s("motifs"),
    output:
        new=f"{OUT}/{{sample}}/pbinner/new_contig_bin.tsv",
        contamination=f"{OUT}/{{sample}}/pbinner/bin_contamination.tsv",
        decisions=f"{OUT}/{{sample}}/pbinner/contig_decisions.tsv",
    params:
        exe=config.get("pbinner", str(REPO / ".venv/bin/pbinner")),
        cache=lambda wc: f"--cache-dir {SAMPLES[wc.sample]['cache_dir']}" if SAMPLES[wc.sample].get("cache_dir") else "",
        extra=config.get("pbinner_extra", ""),
    log:
        f"{OUT}/{{sample}}/logs/pbinner.log",
    benchmark:
        f"{OUT}/{{sample}}/benchmarks/pbinner.tsv"
    threads: THREADS
    shell:
        # pbinner runs from the repository's own environment (see CLAUDE.md), not a conda env
        "{params.exe} run --assembly {input.assembly} --pileup {input.pileup} --contig-bin {input.contig_bin} "
        "--motifs {input.motifs} --out $(dirname {output.new}) --workers {threads} {params.cache} "
        "{params.extra} > {log} 2>&1"


rule write_bins:
    input:
        assembly=s("assembly"),
        contig_bin=contig_bin_of,
    output:
        directory(f"{OUT}/{{sample}}/bins/{{method}}"),
    params:
        min_length=config.get("min_bin_length", 0),
    log:
        f"{OUT}/{{sample}}/logs/write_bins_{{method}}.log",
    shell:
        "python {workflow.basedir}/scripts/write_bins.py --assembly {input.assembly} "
        "--contig-bin {input.contig_bin} --out {output} --min-length {params.min_length} > {log} 2>&1"


rule checkm2_database:
    output:
        DB,
    log:
        f"{DB_DIR}/download.log",
    conda:
        "envs/checkm2.yaml"
    shell:
        "checkm2 database --download --path {DB_DIR} > {log} 2>&1"


rule checkm2:
    input:
        bins=f"{OUT}/{{sample}}/bins/{{method}}",
        db=DB,
    output:
        f"{OUT}/{{sample}}/checkm2/{{method}}/quality_report.tsv",
    log:
        f"{OUT}/{{sample}}/logs/checkm2_{{method}}.log",
    benchmark:
        f"{OUT}/{{sample}}/benchmarks/checkm2_{{method}}.tsv"
    threads: THREADS
    conda:
        "envs/checkm2.yaml"
    shell:
        "checkm2 predict --threads {threads} --input {input.bins} -x fa --database_path {input.db} "
        "--output-directory $(dirname {output}) --force > {log} 2>&1"


rule compare:
    input:
        reports=lambda wc: [f"{OUT}/{wc.sample}/checkm2/{m}/quality_report.tsv" for m in methods_of(wc.sample)],
        tables=lambda wc: [table_of(wc.sample, m) for m in methods_of(wc.sample)],
        lengths=f"{OUT}/{{sample}}/contig_lengths.tsv",
    output:
        summary=f"{OUT}/{{sample}}/comparison/summary.tsv",
        bins=f"{OUT}/{{sample}}/comparison/bins.tsv",
        figure=f"{OUT}/{{sample}}/comparison/bin_refinement.pdf",
    params:
        methods=lambda wc: " ".join(methods_of(wc.sample)),
    log:
        f"{OUT}/{{sample}}/logs/compare.log",
    conda:
        "envs/r.yaml"
    shell:
        "Rscript {workflow.basedir}/scripts/compare_bins.R --sample {wildcards.sample} "
        "--checkm2 {input.reports} --contig-bin {input.tables} --methods {params.methods} "
        "--lengths {input.lengths} --out $(dirname {output.summary}) > {log} 2>&1"


rule contig_lengths:
    input:
        s("assembly"),
    output:
        f"{OUT}/{{sample}}/contig_lengths.tsv",
    shell:
        "python {workflow.basedir}/scripts/write_bins.py --assembly {input} --lengths-only {output}"


# --- Hi-C validation (scripts in hic/; see hic/README.md) ---

rule hic_index:
    input:
        s("assembly"),
    output:
        f"{OUT}/{{sample}}/hic/assembly.chromap.index",
    log:
        f"{OUT}/{{sample}}/logs/hic_index.log",
    conda:
        "../hic/env.yaml"
    shell:
        "chromap -i -r {input} -o {output} > {log} 2>&1"


def hic_index_of(wc):
    # a prebuilt index (config hic_index) saves ~20 min on a 2.5 Gb assembly
    return SAMPLES[wc.sample].get("hic_index", f"{OUT}/{wc.sample}/hic/assembly.chromap.index")


rule hic_map:
    input:
        assembly=s("assembly"), index=hic_index_of, r1=s("hic_r1"), r2=s("hic_r2"),
    output:
        pairs=temp(f"{OUT}/{{sample}}/hic/contacts.pairs"),
    params:
        lines=lambda wc: 4 * int(SAMPLES[wc.sample].get("hic_max_pairs", config.get("hic_max_pairs", 100_000_000))),
        fifo=lambda wc: f"{OUT}/{wc.sample}/hic/fifo",
    log:
        f"{OUT}/{{sample}}/logs/hic_map.log",
    benchmark:
        f"{OUT}/{{sample}}/benchmarks/hic_map.tsv"
    threads: THREADS
    conda:
        "../hic/env.yaml"
    shell:
        # the first hic_max_pairs read pairs, streamed through named pipes (the FASTQs are ~150 GB each)
        "rm -f {params.fifo}_1 {params.fifo}_2 && mkfifo {params.fifo}_1 {params.fifo}_2 && "
        "(head -n {params.lines} {input.r1} > {params.fifo}_1 &) && "
        "(head -n {params.lines} {input.r2} > {params.fifo}_2 &) && "
        "chromap --preset hic -t {threads} -x {input.index} -r {input.assembly} "
        "-1 {params.fifo}_1 -2 {params.fifo}_2 -o {output.pairs} > {log} 2>&1; "
        "status=$?; rm -f {params.fifo}_1 {params.fifo}_2; exit $status"


rule hic_pairs:
    input:
        f"{OUT}/{{sample}}/hic/contacts.pairs",
    output:
        f"{OUT}/{{sample}}/hic/contig_pairs.parquet",
    log:
        f"{OUT}/{{sample}}/logs/hic_pairs.log",
    conda:
        "../hic/env.yaml"
    shell:
        "python {HIC}/contacts.py --pairs {input} --out $(dirname {output}) > {log} 2>&1"


rule hic_contacts:
    input:
        pairs=f"{OUT}/{{sample}}/hic/contig_pairs.parquet",
        contig_bin=s("contig_bin"),
    output:
        calls=f"{OUT}/{{sample}}/hic/hic_calls.tsv",
        links=f"{OUT}/{{sample}}/hic/contig_bin_links.tsv",
    log:
        f"{OUT}/{{sample}}/logs/hic_contacts.log",
    conda:
        "../hic/env.yaml"
    shell:
        "python {HIC}/contacts.py --contig-pairs {input.pairs} --contig-bin {input.contig_bin} "
        "--out $(dirname {output.calls}) > {log} 2>&1"


rule hic_refine:
    input:
        calls=f"{OUT}/{{sample}}/hic/hic_calls.tsv",
        contig_bin=s("contig_bin"),
    output:
        f"{OUT}/{{sample}}/hic/new_contig_bin.tsv",
    log:
        f"{OUT}/{{sample}}/logs/hic_refine.log",
    conda:
        "../hic/env.yaml"
    shell:
        "python {HIC}/refine.py --hic-calls {input.calls} --contig-bin {input.contig_bin} --out {output} > {log} 2>&1"


rule hic_bin_quality:
    input:
        pairs=f"{OUT}/{{sample}}/hic/contig_pairs.parquet",
        calls=f"{OUT}/{{sample}}/hic/hic_calls.tsv",
        lengths=f"{OUT}/{{sample}}/contig_lengths.tsv",
        tables=lambda wc: [table_of(wc.sample, m) for m in methods_of(wc.sample)],
        reports=lambda wc: [f"{OUT}/{wc.sample}/checkm2/{m}/quality_report.tsv" for m in methods_of(wc.sample)],
        diamond=f"{OUT}/{{sample}}/checkm2/original/quality_report.tsv",
    output:
        summary=f"{OUT}/{{sample}}/hic_quality/summary.tsv",
        bins=f"{OUT}/{{sample}}/hic_quality/bins.tsv",
        visibility=f"{OUT}/{{sample}}/hic_quality/marker_visibility.tsv",
    params:
        sets=lambda wc: " ".join(f"--set {m} {table_of(wc.sample, m)} --checkm2 {m} {OUT}/{wc.sample}/checkm2/{m}/quality_report.tsv"
                                 for m in methods_of(wc.sample)),
        contig_bin=s("contig_bin"),
    log:
        f"{OUT}/{{sample}}/logs/hic_bin_quality.log",
    conda:
        "../hic/env.yaml"
    shell:
        "(python {HIC}/bin_quality.py --pairs {input.pairs} --hic-calls {input.calls} --lengths {input.lengths} "
        "{params.sets} --out $(dirname {output.summary}) && "
        "python {HIC}/marker_visibility.py --diamond $(dirname {input.diamond})/diamond_output --checkm2 {input.diamond} "
        "--hic-calls {input.calls} --contig-bin {params.contig_bin} --lengths {input.lengths} "
        "--out {output.visibility}) > {log} 2>&1"


rule hic_validate:
    input:
        calls=f"{OUT}/{{sample}}/hic/hic_calls.tsv",
        contig_bin=s("contig_bin"),
        tables=lambda wc: [f"{OUT}/{wc.sample}/{m}/new_contig_bin.tsv" for m in methods_of(wc.sample) if m not in ("original", "hic")],
    output:
        summary=f"{OUT}/{{sample}}/hic_validation/summary.tsv",
        contigs=f"{OUT}/{{sample}}/hic_validation/contigs.tsv",
    params:
        methods=lambda wc: " ".join(f"--method {m} {OUT}/{wc.sample}/{m}/new_contig_bin.tsv "
                                    f"{OUT}/{wc.sample}/{m}/bin_contamination.tsv"
                                    for m in methods_of(wc.sample) if m not in ("original", "hic")),
    log:
        f"{OUT}/{{sample}}/logs/hic_validate.log",
    conda:
        "../hic/env.yaml"
    shell:
        "python {HIC}/validate.py --hic-calls {input.calls} --contig-bin {input.contig_bin} {params.methods} "
        "--out $(dirname {output.summary}) > {log} 2>&1"


rule hic_probability:
    input:
        decisions=f"{OUT}/{{sample}}/pbinner/contig_decisions.tsv",
        links=f"{OUT}/{{sample}}/hic/contig_bin_links.tsv",
        contig_bin=s("contig_bin"),
        lengths=f"{OUT}/{{sample}}/contig_lengths.tsv",
    output:
        f"{OUT}/{{sample}}/hic_probability/calibration.tsv",
        f"{OUT}/{{sample}}/hic_probability/contigs.tsv",
    log:
        f"{OUT}/{{sample}}/logs/hic_probability.log",
    conda:
        "../hic/env.yaml"
    shell:
        "python {HIC}/probability_vs_hic.py --decisions {input.decisions} --links {input.links} "
        "--contig-bin {input.contig_bin} --lengths {input.lengths} --out $(dirname {output[0]}) > {log} 2>&1"


rule hic_probability_plot:
    input:
        f"{OUT}/{{sample}}/hic_probability/calibration.tsv",
    output:
        f"{OUT}/{{sample}}/hic_probability/probability_vs_hic.pdf",
    log:
        f"{OUT}/{{sample}}/logs/hic_probability_plot.log",
    conda:
        "envs/r.yaml"
    shell:
        "(Rscript {HIC}/plot_probability_vs_hic.R --dir $(dirname {input}) --sample {wildcards.sample} && "
        "Rscript {HIC}/plot_contig_probabilities.R --dir $(dirname {input}) --sample {wildcards.sample}) > {log} 2>&1"

    given-names: Søren
    email: shei@bio.aau.dk
license: MIT
repository-code: "https://github.com/SorenHeidelbach/epirefine"
url: "https://github.com/SorenHeidelbach/epirefine"
keywords:
  - metagenomics
  - binning
  - bin refinement
  - nanopore
  - DNA methylation
  - Nanomotif
  - MAG
